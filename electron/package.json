{
  "name": "bti-voice-desktop",
  "version": "1.0.0",
  "description": "BTI Voice – Shared SMS & VOIP Desktop App",
  "author": "Business Technology Insight",
  "main": "main.js",
  "scripts": {
    "start":        "electron .",
    "build:win":    "electron-builder --win --x64",
    "create-icons": "node create-icons.js"
  },
  "devDependencies": {
    "electron":         "^29.1.0",
    "electron-builder": "^24.9.1",
    "sharp":            "^0.33.2"
  },
  "build": {
    "appId":       "com.businesstechnologyinsight.bti-voice",
    "productName": "BTI Voice",
    "copyright":   "Business Technology Insight",
    "directories": {
      "output": "../../dist-electron"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon":   "assets/icon.png"
    },
    "nsis": {
      "oneClick":                           false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut":              true,
      "createStartMenuShortcut":            true,
      "shortcutName":                       "BTI Voice"
    },
    "files": [
      "main.js",
      "preload.js",
      "widget-preload.js",
      "call-widget.html",
      "assets/**"
    ]
  }
}
