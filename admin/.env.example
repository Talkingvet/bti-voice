# bti-voice-admin — BTI-only control plane (admin portal Phase 2)
# Copy the values into Railway → bti-voice-admin → Variables. Never commit a real .env.

# Provided automatically when you attach a Postgres plugin to the service.
DATABASE_URL=postgresql://user:pass@host:5432/railway

NODE_ENV=production
PORT=3000

# One long random secret. Signs login sessions AND encrypts every tenant's
# TENANT_ADMIN_KEY at rest, so losing it means re-entering every tenant key.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORTAL_SECRET=

# First-boot bootstrap: created only when the portal_users table is empty.
# Log in with these, change the password when prompted, then delete both vars.
PORTAL_ADMIN_USERNAME=danny
PORTAL_ADMIN_PASSWORD=
PORTAL_ADMIN_NAME=Danny

# Optional. How long to wait on a customer deploy before calling it "unreachable".
TENANT_TIMEOUT_MS=8000
