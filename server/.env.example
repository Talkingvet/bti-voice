# ─────────────────────────────────────────────────────────────────────────────
# BTI Voice — environment template (per-customer single-tenant deploy)
# Copy into the Railway service's Variables tab (or .env for local dev).
# REQUIRED vars are marked; everything else has a safe default or is optional.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# REQUIRED. Postgres connection string. On Railway, reference the Postgres
# plugin variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# REQUIRED in production — server exits on boot without it. 64+ random chars.
# Generate: openssl rand -hex 32
JWT_SECRET=

# REQUIRED. Public URL of this deployment (no trailing slash).
# e.g. https://customername-voice.up.railway.app
SERVER_URL=

# Railway sets PORT automatically; only set for local dev.
# PORT=3000

# Set to "production" on Railway (enables strict webhook validation, JWT enforcement).
NODE_ENV=production

# ── First-boot admin bootstrap (fresh deploys only) ──────────────────────────
# With SEED_DEMO unset, a fresh empty database creates ONE admin login from
# these. Remove/ignore after first boot. Password must be 8+ chars.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# ADMIN_NAME=Jane Smith

# NEVER set this on a customer deploy. true = seed BTI's 5 demo agents (dev only).
# SEED_DEMO=false

# ── Branding ─────────────────────────────────────────────────────────────────
# Product name shown in the UI (splash, title bar, About). Build-time var —
# changing it requires a redeploy. Default: BTI Voice
VITE_BRAND_NAME=
# Same name for server-side log lines / Zoho descriptions. Keep equal to VITE_BRAND_NAME.
BRAND_NAME=

# REQUIRED for sensible AI summaries + after-hours texts: the CUSTOMER's
# business name as callers know it (e.g. "Acme Plumbing").
COMPANY_NAME=

# Optional extra context for AI call summaries,
# e.g. "Acme Plumbing is a residential plumbing company in Fort Myers, FL."
# AI_SUMMARY_CONTEXT=

# ── Twilio (use the CUSTOMER's subaccount credentials) ───────────────────────
# REQUIRED. Subaccount SID + auth token (Console → Account → Subaccounts).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# REQUIRED for browser/desktop calling. API key created IN THE SUBACCOUNT
# (Console → Account → API keys & tokens).
TWILIO_API_KEY=
TWILIO_API_SECRET=

# REQUIRED for outbound calling. TwiML App SID (see runbook §3.4).
TWILIO_TWIML_APP_SID=

# REQUIRED. Default/fallback company number in E.164 (+1XXXXXXXXXX).
TWILIO_PHONE_NUMBER=

# REQUIRED for SMS once the customer's A2P campaign is approved.
# Leave unset during the voice-only phase.
# TWILIO_MESSAGING_SERVICE_SID=

# Reject unsigned webhook requests. Defaults to strict in production; set
# false only to debug inbound 403s.
# TWILIO_STRICT_WEBHOOKS=true

# Record calls + generate transcripts/AI summaries. Needs recording disclosure
# (the app plays one automatically before recorded dials).
ENABLE_RECORDING=true

# ── OpenAI (transcription + AI call summaries) ───────────────────────────────
# REQUIRED if ENABLE_RECORDING=true.
OPENAI_API_KEY=

# ── BTI tenant admin (admin portal Phase 1) ───────────────────────────────────
# REQUIRED on every customer deploy. Per-deploy secret held ONLY by BTI —
# unlocks /api/tenant/* (feature toggles, seat limit, renewal date, user
# resets, usage). Paste the same value into the BTI portal's tenant record.
# Unset = the endpoints answer 404 (no admin surface at all).
# Generate: openssl rand -hex 32
TENANT_ADMIN_KEY=

# ── Admin / updates (usually skip for customer deploys) ──────────────────────
# Stable key for /admin/activity dashboard. Random per boot if unset.
# ADMIN_KEY=

# Desktop-app updater (Windows). Browser-only pilots: leave all unset.
# LATEST_VERSION=1.5.0
# GH_TOKEN=

# ── Zoho CRM add-on (OPTIONAL — only if the customer runs Zoho CRM) ──────────
# App runs fine with all of these unset: the server skips every CRM sync and
# GET /api/features reports zoho=false, so the client hides the CRM panel,
# sync buttons, Zoho wrap-up fields and the Settings→About Zoho section.
# ALL THREE OAuth values must be set for the add-on to turn on.
# Self Client from the CUSTOMER's Zoho org, scopes: ZohoCRM.modules.ALL,ZohoCRM.users.READ
# Their org also needs the BTI_Voice custom module with a UNIQUE BTI_Ref field.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_WIDGET_KEY=

# ── BTI Huddle (video calls / screen share / meetings / team chat) ──
# OFF unless this is exactly "true". Ships inert: /huddle and /api/huddle 404
# without it. Uses Twilio Network Traversal (TURN) via the account SID/token
# above — relay minutes are billed per GB when a direct path fails.
# ENABLE_HUDDLE=true
